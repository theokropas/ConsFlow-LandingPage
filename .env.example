# URL pública usada para canonical, sitemap y metadata social.
NEXT_PUBLIC_SITE_URL=https://cons-flow-landing-page.vercel.app

# Resend: crear una API key y verificar el dominio del remitente antes de producción.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=ConsFlow <contacto@tu-dominio-verificado.com>

# Rate limit durable para el Route Handler de contacto.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
